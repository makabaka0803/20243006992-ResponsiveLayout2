<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Lab 1 title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Lab 1"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:gravity="center"/>

    <!-- Full-width white container for Responsive Layout 1 and four color blocks -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="40dp"
            android:text="Responsive Layout 1"
            android:textColor="#000000"
            android:textSize="20sp"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#ff0000"
                android:text="This"
                android:textColor="#ffffff"
                android:gravity="center"
                android:textSize="18sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#0000ff"
                android:text="is"
                android:textColor="#ffffff"
                android:gravity="center"
                android:textSize="18sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#6b489e"
                android:text="my"
                android:textColor="#ffffff"
                android:gravity="center"
                android:textSize="18sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#ffff00"
                android:text="first"
                android:textColor="#000000"
                android:gravity="center"
                android:textSize="18sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Black space area with Android Application text in the middle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="382dp"
        android:layout_weight="1"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Android Application"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Bottom full-width white container, no extra bottom black space -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="30dp">

        <!-- Purple oval button: Change -->
        <TextView
            android:id="@+id/btnChange"
            android:layout_width="150dp"
            android:layout_height="80dp"
            android:layout_marginEnd="24dp"
            android:text="Change"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/btn_purple_oval"/>

        <!-- Purple oval button: Cancel -->
        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="150dp"
            android:layout_height="80dp"
            android:text="Cancel"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/btn_purple_oval"/>
    </LinearLayout>

</LinearLayout>